{
	"name": "@earendil-works/primecord-private-context-gateway",
	"version": "0.7.1",
	"description": "Private read-only MCP gateway for opted-in Primecord snapshots",
	"private": true,
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"primecord-pcg": "./dist/cli.js"
	},
	"files": [
		"dist",
		"deploy",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/cli.js",
		"dev": "tsx watch src/cli.ts",
		"test": "vitest --run"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"jose": "^6.2.8",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"shx": "^0.4.0",
		"tsx": "^4.23.1",
		"typescript": "^5.7.3",
		"vitest": "^4.1.9"
	},
	"engines": {
		"node": ">=22.8.0"
	}
}
